{
    "name": "leeovery/laravel-idempotency",
    "description": "Idempotency keys for Laravel side effects: an atomic once() and the claim, complete and completed primitives, backed by one unique index.",
    "keywords": [
        "laravel",
        "idempotency",
        "idempotent",
        "laravel-idempotency"
    ],
    "homepage": "https://github.com/leeovery/laravel-idempotency",
    "license": "MIT",
    "authors": [
        {
            "name": "Lee Overy",
            "email": "me@leeovery.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.1|^5.0",
        "pestphp/pest-plugin-arch": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0|^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LeeOvery\\Idempotency\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeeOvery\\Idempotency\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "pint": "./vendor/bin/pint --parallel",
        "pint-dirty": "./vendor/bin/pint --dirty --parallel",
        "pint-sniff": "./vendor/bin/pint --test --parallel",
        "rector": "./vendor/bin/rector",
        "rector-dry": "./vendor/bin/rector --dry-run",
        "pest": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/pest --compact"
        ],
        "pest-dirty": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/pest --dirty --compact"
        ],
        "pest-parallel": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/pest --parallel"
        ],
        "pest-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/pest --coverage"
        ],
        "pest-type-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/pest --type-coverage"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LeeOvery\\Idempotency\\IdempotencyServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
